# ---- colcon / ament build products ----
build/
install/
log/

# ---- generated by figure tools ----
tools/__pycache__/
**/__pycache__/
*.pyc

# ---- compiled helpers in tools/win_capture ----
# sources are win_grab.c / win_id_resize.c / win_resize.c / xclick.c / pngrab.c;
# build them locally with:  make -C tools/win_capture
tools/win_capture/win_grab
tools/win_capture/win_id_resize
tools/win_capture/win_resize
tools/win_capture/xclick
tools/win_capture/pngrab

# ---- runtime output ----
# teach recordings written by `read_angle`; the three checked-in reference
# recordings under src/hardware/teach_path/ are deliberately kept.
*.log

# ---- editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- ROS 1 leftovers (nothing here should be built by colcon) ----
# reference/ros1-original carries its own COLCON_IGNORE instead of being
# listed here, so the tree stays browsable on GitHub.
